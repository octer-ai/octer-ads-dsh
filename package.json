{
  "name": "octer-ads-dsh",
  "version": "0.2.0",
  "description": "Free-forever ad management, optimization, and performance reporting for DeepSeek Harness.",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "legacy.js",
    "legacy-oauth.js",
    "icon.png",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5 || >=0.2.3-alpha.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ads",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octer-ai/octer-ads-dsh.git"
  },
  "scripts": {
    "test": "node --test"
  }
}
