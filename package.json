{
  "name": "octer-ads-dsh",
  "version": "0.3.0",
  "description": "Free-forever ad management, optimization, and performance reporting for DeepSeek Harness.",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.cjs",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "binding.js",
    "workspace.js",
    "client.cjs",
    "README.en.md",
    "legacy.js",
    "legacy-oauth.js",
    "icon.png",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5 || >=0.2.3-alpha.2 <0.3.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ads",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octer-ai/octer-ads-dsh.git"
  },
  "scripts": {
    "build:client": "node build-client.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
